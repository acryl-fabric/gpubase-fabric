node_modules/

# Helm
deploy/**/charts/*.tgz
**/chart/charts/*.tgz
*.tgz

# Secrets and environment-specific values (never commit)
.env
.env.*
*.key
*.pem
*.p12
kubeconfig*
*.kubeconfig
values-local*.yaml
values-*.private.yaml
inventory.ini
hosts.ini

